# FieldOps Intelligence environment configuration.
#
# Copy this file to `.env` for local overrides. `.env` is git-ignored and must
# never be committed. The hosted Summit pilot does NOT use this file: those
# values are entered in the Streamlit Community Cloud "Secrets" interface.
# See docs/summit-deployment.md.

# ---------------------------------------------------------------------------
# Local development (default): two separate SQLite files in the repository root
# ---------------------------------------------------------------------------
# The operational and demo URLs must always resolve to different databases.
# Operational holds real records and starts blank; demo holds the synthetic
# Summit dataset. Nothing is ever copied between them.
FIELDOPS_DATABASE_URL=sqlite:///fieldops_operational.db
FIELDOPS_DEMO_DATABASE_URL=sqlite:///fieldops_demo.db

# ---------------------------------------------------------------------------
# Hosted pilot: managed PostgreSQL (placeholders only — never commit real values)
# ---------------------------------------------------------------------------
# Use the `postgresql+psycopg://` scheme so SQLAlchemy selects the Psycopg 3
# driver, and keep the provider's SSL query parameter on the URL.
#
# FIELDOPS_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/fieldops_operational?sslmode=require
# FIELDOPS_DEMO_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/fieldops_demo?sslmode=require

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR, or CRITICAL. Connection URLs are never logged.
FIELDOPS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Auto-seeding
# ---------------------------------------------------------------------------
# Must stay false. Demo data is loaded explicitly from the UI or from
# `python scripts/seed_demo_data.py`, and only ever into the demo database.
FIELDOPS_AUTO_SEED=false
